@model IEnumerable<Ntd_Day14.Models.Sach>

<partial name="_DanhSachSach" model="Model" />

@section Scripts {
    <script>
        $(document).ready(function () {
            $(".menu-theloai").click(function () {
                var id = $(this).data("id");
                var ten = $(this).data("ten");

                $(".menu li").removeClass("active");
                $(this).parent().addClass("active");

                $.ajax({
                    url: '@Url.Action("LocTheoTheLoai", "Home")',
                    type: 'GET',
                    data: { maTL: id, tenTL: ten },
                    success: function (res) {
                        $("#main-content-area").html(res);
                    }
                });
            });
        });
    </script>
}