@model IEnumerable<MyAppMVC.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<h2 class="my-4 text-secondary">Quản lý sản phẩm</h2>

<div class="table-responsive">
    <table class="table align-middle table-hover">
        <thead class="border-bottom">
            <tr class="text-muted">
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
                <th>Created At</th>
                <th>Image</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Price.ToString("N0") đ</td>
                    <td>@item.CreatedAt.ToString("dd-MM-yyyy")</td>
                    <td>
                        <img src="@item.ImageUrl" style="width: 50px; height: 50px; object-fit: contain;" alt="@item.Name"
                             onerror="this.src='https://via.placeholder.com/50?text=Bag';" />
                    </td>
                    <td>
                        <a href="#" class="btn btn-success btn-sm px-3">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>