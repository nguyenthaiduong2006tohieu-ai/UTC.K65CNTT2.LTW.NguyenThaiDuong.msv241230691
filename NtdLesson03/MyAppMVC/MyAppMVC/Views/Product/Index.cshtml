@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var categories = ViewBag.Categories as List<MyAppMVC.Models.Category>;
    var products = ViewBag.Products as List<MyAppMVC.Models.Product>;
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-3 mb-4">
            <h5 class="fw-bold mb-3">DANH MỤC</h5>
            <div class="list-group">
                <a asp-route="sanpham" class="list-group-item list-group-item-action">Tất cả sản phẩm</a>
                @if (categories != null)
                {
                    @foreach (var cat in categories)
                    {
                        <a asp-route="sanpham" asp-route-categoryId="@cat.Id" class="list-group-item list-group-item-action">
                            @cat.Name
                        </a>
                    }
                }
            </div>
        </div>
        <div class="col-md-9">
            <h4 class="fw-bold mb-3">Danh sách sản phẩm</h4>
            <div class="row">
                @if (products != null && products.Any())
                {
                    @foreach (var item in products)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 p-2 shadow-sm text-center">
                                <img src="@item.Image" class="card-img-top mx-auto" alt="@item.Name" style="height: 200px; object-fit: contain;">
                                <div class="card-body p-2 d-flex flex-column justify-content-between">
                                    <h6 class="card-title mt-2">@item.Name</h6>
                                    <div>
                                        <p class="mb-2 text-muted small">
                                            <del>Giá: @item.Price.ToString("N0")</del>
                                            <span class="text-danger fw-bold ms-1">Giá: @item.SalePrice.ToString("N0")</span>
                                        </p>
                                        <a asp-route="chitiet" asp-route-id="@item.Id" class="btn btn-success btn-sm w-100">Chi tiết</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <p class="text-muted">Không có sản phẩm nào trong danh mục này.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>