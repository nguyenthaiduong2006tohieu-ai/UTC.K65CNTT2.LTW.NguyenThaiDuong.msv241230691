@model IEnumerable<MyAppMVC.Models.Product>

@{
    ViewData["Title"] = "Trang chủ";
}

<partial name="Banner" />

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-3">
            <partial name="_CategoryPartial" />
        </div>
        <div class="col-md-9">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white fw-bold">
                    Sản phẩm mới nhất
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var item in Model)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card h-100 p-2 shadow-sm text-center">
                                    <img src="@item.Image" class="card-img-top mx-auto" style="height: 160px; object-fit: contain;" alt="@item.Name" />
                                    <div class="card-body p-2">
                                        <p class="card-text small fw-bold">@item.Name</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white fw-bold">
                    Sản phẩm nổi bật (Hot Products)
                </div>
                <div class="card-body">
                    @await Component.InvokeAsync("HotProduct")
                </div>
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary text-white fw-bold">
                    Tải dữ liệu qua AJAX (Bài 3)
                </div>
                <div class="card-body">
                    <button id="loadAjax" class="btn btn-sm btn-primary">Click load book từ partialResult</button>
                    <div id="data-from-ajax" class="mt-3">
                        <p class="text-muted mb-0">Chưa tải dữ liệu...</p>
                    </div>
                </div>
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white fw-bold">
                    Popular Book load từ BookComponent (Bài 4)
                </div>
                <div class="card-body">
                    @await Component.InvokeAsync("Book")
                </div>
            </div>
        </div>
    </div>
    <div class="row mt-4 bg-dark text-white p-4 rounded">
        <div class="col-md-6">
            <h6 class="fw-bold">GIỚI THIỆU</h6>
            <p class="small text-muted mb-0">Lorem ipsum dolor sit amet consectetur adipisicing elit. Debitis ab suscipit deserunt mollitia reiciendis, nobis iure aliquam velit et laboriosam ducimus veritatis corporis est.</p>
        </div>
        <div class="col-md-6">
            <h6 class="fw-bold">LIÊN HỆ</h6>
            <p class="small text-muted mb-0">Lorem ipsum dolor sit amet consectetur adipisicing elit. Odit amet suscipit quasi quisquam impedit magni molestias. Dolores, aliquid commodi ut esse eos voluptatem.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#loadAjax').click(function () {
            $('#data-from-ajax').load('/Book/PopularBook');
        });
    </script>
}