@model Student

<div class="container mt-3">
    <h2>Thêm mới sinh viên</h2>

    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-controller="Student" asp-action="Create" method="post" class="mt-3">

        <div class="form-group row mb-2">
            <label asp-for="Name" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" placeholder="Họ tên">
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Email" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Email" class="form-control" placeholder="Email (đuôi @@gmail.com)">
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Password" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Password" type="password" class="form-control" placeholder="Mật khẩu trên 8 ký tự, có hoa, thường, số, ký tự đặc biệt">
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Branch" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <select asp-for="Branch" class="form-control" asp-items="Html.GetEnumSelectList<Branch>()">
                    <option value="">-- Chọn ngành học --</option>
                </select>
                <span asp-validation-for="Branch" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="IsRegular" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10 d-flex align-items-center">
                <input type="checkbox" class="form-check-input" asp-for="IsRegular">
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="DateOfBorth" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="DateOfBorth" class="form-control" type="date">
                <span asp-validation-for="DateOfBorth" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Gender" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                @foreach (var gender in ViewBag.AllGenders)
                {
                    <label class="radio-inline mr-3">
                        <input type="radio" asp-for="Gender" value="@gender" id="Gender@(gender)" /> @gender
                    </label>
                }
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Address" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <textarea asp-for="Address" class="form-control" placeholder="Địa chỉ"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <label asp-for="Score" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Score" class="form-control" placeholder="Nhập điểm từ 0.0 đến 10.0">
                <span asp-validation-for="Score" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mb-2">
            <div class="col-sm-10 offset-sm-2">
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}